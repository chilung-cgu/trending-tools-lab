  "cards": [
    {
      "dot": "cyan",
      "title": "擷取與保鮮機制 (Fetch & Freshness)",
      "items": [
        "每週一 06:45 與 07:30 台北時間雙排程執行，降低暫態失敗風險",
        "請求攜帶動態 _fresh 奈秒時間戳與 no-cache 標頭防快取穿透",
        "嚴格檢驗 HTTP Date 偏差與 Age 標頭均不得超過 15 分鐘"
      ]
    },
    {
      "dot": "amber",
      "title": "重試與退避策略 (Retry & Backoff)",
      "items": [
        "HTTP 錯誤或 HTML 解析異常時，單一週期最多重試 3 次",
        "採 2 * attempt 線性退避 (2s, 4s)，每次失敗保存完整 HTML 至 debug/",
        "3 次全數失敗時標記 error，絕不回退至上一期快照以防數據陳舊"
      ]
    },
    {
      "dot": "emerald",
      "title": "品質門禁與版本控制 (Gate & Persistence)",
      "items": [
        "獨立 Python 步驟嚴格斷言 schema_version==1、status 及 1..10 排名",
        "僅在 exit_code == 0 全數成功時才備份最新 latest-success.json",
        "有效 JSON 即使爬取失敗仍先 commit / push；之後上傳 debug 並標記失敗",
        "JSON 驗證或 Git push 失敗則中止 job，不會執行後續 debug 上傳"
      ]
    }
  ]
}
